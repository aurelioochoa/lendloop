# Read by docker compose for the n8n container only (Next.js never loads this file).
# `scripts/setup-secrets.sh` creates .env.n8n from this file with fresh secrets and sets
# the same values on your Convex deployment.

# Convex -> n8n: Convex signs webhook calls with it, n8n verifies. Same value as the
# Convex env var of the same name.
N8N_WEBHOOK_SECRET=

# n8n -> Convex: n8n signs calls to Convex HTTP endpoints with it. Same value as the
# Convex env var of the same name. Use a different value from N8N_WEBHOOK_SECRET.
LENDLOOP_API_SECRET=

# Where n8n reaches Convex HTTP actions (the ".site" URL, not ".cloud").
#   Local Convex backend (npx convex dev, anonymous):  http://host.docker.internal:3211
#   Convex cloud dev deployment:                       https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# Timezone for the daily 09:00 reminder schedule.
GENERIC_TIMEZONE=UTC
